---
/**
 * Decorative icons. Always hidden from assistive technology and removed from
 * the tab order — the accessible name comes from the surrounding text or an
 * aria-label on the control itself.
 */
interface Props {
  name:
    | "arrow-left"
    | "arrow-right"
    | "arrow-dr"
    | "chevron-down"
    | "chevron-right"
    | "phone"
    | "mail"
    | "document"
    | "building"
    | "analysis"
    | "report"
    | "check"
    | "check-circle"
    | "target"
    | "trend"
    | "award"
    | "draft"
    | "helmet"
    | "shield"
    | "user"
    | "pin"
    | "cookie";
  class?: string;
}
const { name, class: className = "h-4 w-4" } = Astro.props;

const paths: Record<Props["name"], string[]> = {
  // One directional pair, mirrored, so the slider's two controls match.
  "arrow-left": ["M19 12H5", "M11 6l-6 6 6 6"],
  "arrow-right": ["M5 12h14", "M13 6l6 6-6 6"],
  // 45°, ka donjem desnom uglu — CTA strelica pre design-audita.
  "arrow-dr": ["M7 7l10 10", "M17 7v10H7"],
  "chevron-down": ["M6 9l6 6 6-6"],
  // Breadcrumb separator.
  "chevron-right": ["m9 5 7 7-7 7"],
  phone: [
    "M13 2a9 9 0 0 1 9 9",
    "M13 6a5 5 0 0 1 5 5",
    "M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384",
  ],
  mail: [
    "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z",
    "M22 6l-10 7L2 6",
  ],
  // The five steps of the Ablauf, in order. Redrawn from the current Lucide
  // icon set (lucide-static, ISC license, https://lucide.dev) — pulled once
  // via npm and hand-copied in as static path data, so the site still makes
  // zero third-party requests; nothing loads from their CDN at runtime.
  // <circle>/<rect> primitives were converted to path-only shapes to match
  // this renderer (same trick check-circle already uses for its ring).
  document: [
    "M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z",
    "M14 2v5a1 1 0 0 0 1 1h5",
    "M10 9H8",
    "M16 13H8",
    "M16 17H8",
  ],
  building: [
    "M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8",
    "M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
  ],
  analysis: ["m8 11 2 2 4-4", "M3 11a8 8 0 1 0 16 0a8 8 0 1 0 -16 0", "m21 21-4.3-4.3"],
  report: [
    "M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z",
    "M14 2v5a1 1 0 0 0 1 1h5",
    "m9 15 2 2 4-4",
  ],
  check: ["M20 6L9 17l-5-5"],
  // A checkmark inside an outline circle — the price-comparison table's
  // "included" marker. The circle is drawn as two arcs (paths only, no
  // <circle> in this renderer).
  "check-circle": ["M2 12a10 10 0 1 0 20 0 10 10 0 1 0 -20 0", "M9 12l2 2 4-4"],
  // Bento cards and the Ingenieurleistungen process.
  target: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z", "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z", "M12 11.5v1"],
  trend: ["M3 17l6-6 4 4 8-8", "M15 7h6v6"],
  award: ["M12 3l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L4.2 8.7l5.4-.8z", "M8 20h8"],
  draft: [
    "M13 21h8",
    "M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z",
  ],
  helmet: [
    "M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5",
    "M14 6a6 6 0 0 1 6 6v3",
    "M4 15v-3a6 6 0 0 1 6-6",
    "M3 15H21A1 1 0 0 1 22 16V18A1 1 0 0 1 21 19H3A1 1 0 0 1 2 18V16A1 1 0 0 1 3 15Z",
  ],
  // Hero trust row and the regional badge. Same source and treatment as the
  // icons above: Lucide path data, circles redrawn as arcs so the renderer
  // needs no <circle> primitive.
  shield: [
    "M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z",
    "m9 12 2 2 4-4",
  ],
  user: [
    "M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2",
    "M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z",
  ],
  pin: [
    "M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0z",
    "M12 8a2 2 0 1 0 0 4 2 2 0 0 0 0-4z",
  ],
  // Cookie-consent banner. The "chips" are zero-length paths — a round
  // linecap turns a zero-length stroke into a dot, the same trick already
  // used nowhere else in this file but standard for this exact icon in the
  // Lucide set this component redraws from.
  cookie: [
    "M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5",
    "M8.5 8.5v.01",
    "M16 15.5v.01",
    "M12 12v.01",
    "M11 17v.01",
    "M7 14v.01",
  ],
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
