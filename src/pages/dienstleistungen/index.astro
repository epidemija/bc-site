---
/**
 * Dienstleistungen — category page.
 *
 * Third and last of the category hubs, built like /gutachten/ and
 * /ingenieurleistungen/: an animated header (§5d), cards for the four services
 * below it, the client's own copy, and the shared service area.
 *
 * The graphic is MeasureScan — a room measured on site turning into the three
 * documents that come out of it, which is what this whole branch delivers.
 */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import AnimatedPageHero from "../../components/sections/AnimatedPageHero.astro";
import MeasureScan from "../../components/sections/MeasureScan.astro";
import Icon from "../../components/ui/Icon.astro";
import SurveyContour from "../../components/ui/SurveyContour.astro";
import { PAGES } from "../../config/pages";
import { subpageSchema, serviceSchemas } from "../../seo/schema";
import { routes } from "../../config/site";
import imgAufmass from "../../assets/images/hero-bc-immowert-aufmass.jpg";
import imgGrundrisse from "../../assets/images/hero-bc-immowert-digitale-grundrisse.jpg";
import imgFlaechen from "../../assets/images/hero-bc-immowert-flaechenberechnung.jpg";
import imgAnVerkauf from "../../assets/images/hero-bc-immowert-an-und-verkaufsberatung.jpg";
import ClosingCta from "../../components/sections/ClosingCta.astro";
import EinsatzgebietSection from "../../components/sections/EinsatzgebietSection.astro";
import VerticalFeatureTabs from "../../components/sections/VerticalFeatureTabs.astro";

const page = PAGES.dienstleistungen;

/** The four services that sit below this page. */
const leistungen = [
  {
    name: "Aufmaß",
    description:
      "Wir erfassen den aktuellen Gebäudebestand digital vor Ort – als Grundlage für " +
      "Grundrisse, Flächenberechnungen und weitere Planungen.",
    href: routes.aufmass,
    img: imgAufmass,
    imgAlt: "Lasermessgerät beim Aufmaß eines Raums in einer Bestandsimmobilie",
  },
  {
    name: "Digitale Grundrisse",
    description:
      "Aus unserem Vor-Ort-Aufmaß oder vorhandenen Bestandsunterlagen erstellen wir " +
      "aktuelle, maßstabsgetreue und auf Wunsch bemaßte Grundrisse.",
    href: routes.digitaleGrundrisse,
    img: imgGrundrisse,
    imgAlt: "Digitaler, bemaßter Grundriss einer Wohnung auf einem Tablet",
  },
  {
    name: "Flächenberechnung",
    description:
      "Wir erstellen nachvollziehbare Wohn- und Nutzflächenberechnungen nach WoFlV und " +
      "DIN 277 – passend zum jeweiligen Verwendungszweck.",
    href: routes.flaechenberechnung,
    img: imgFlaechen,
    imgAlt: "Berechnung von Wohn- und Nutzflächen nach WoFlV und DIN 277",
  },
  {
    name: "An- und Verkaufsberatung",
    description:
      "Wir prüfen den technischen und wirtschaftlichen Zustand einer Immobilie und " +
      "unterstützen Sie dabei, Kauf oder Verkauf besser einzuschätzen.",
    href: routes.anUndVerkaufsberatung,
    img: imgAnVerkauf,
    imgAlt: "Beratungsgespräch zum Kauf oder Verkauf einer Immobilie",
  },
];

/**
 * What is actually produced, drawn from the second paragraph of the client's
 * text so the list and the prose cannot disagree. Icon per item, same
 * pattern as arbeitsfelder on Ingenieurleistungen, rather than a single
 * repeated checkmark.
 */
const unterlagen: { label: string; icon: "target" | "draft" | "report" | "analysis" | "building" }[] = [
  { label: "Gebäudeaufmaße vor Ort", icon: "target" },
  { label: "Digitale und bemaßte Grundrisse", icon: "draft" },
  { label: "Wohnflächenberechnungen nach WoFlV", icon: "report" },
  { label: "Nutzflächenberechnungen nach DIN 277", icon: "analysis" },
  { label: "Unabhängige An- und Verkaufsberatung", icon: "building" },
];

/**
 * The two situations where these documents matter — tab title plus the
 * client's own paragraphs, unchanged from the previous plain two-column
 * section, now behind the vertical tabs.
 */
const situationen = [
  {
    icon: "draft" as const,
    title: "Wenn die alten Pläne nicht mehr stimmen",
    paragraphs: [
      "Gerade bei Bestandsimmobilien fehlen häufig aktuelle Pläne, oder vorhandene Unterlagen entsprechen nicht mehr dem tatsächlichen Gebäude. Umbauten, Grundrissänderungen oder Nutzungsänderungen führen dazu, dass alte Baupläne und Flächenangaben ihre Aussagekraft verlieren.",
      "Durch ein präzises Vor-Ort-Aufmaß erfassen wir den aktuellen Gebäudebestand digital und erstellen daraus maßstabsgetreue Grundrisse sowie Wohn- und Nutzflächenberechnungen. Die neu erstellten Unterlagen können anschließend problemlos von Architekten, Energieberatern, Fachplanern, Banken oder Behörden weiterverwendet werden.",
    ],
  },
  {
    icon: "trend" as const,
    title: "Beim Kauf und beim Verkauf",
    paragraphs: [
      "Beim Immobilienkauf lassen sich Zustand und möglicher Investitionsbedarf für Laien häufig nur schwer einschätzen. Wir schauen uns die Immobilie unabhängig an und helfen Ihnen dabei, technische Auffälligkeiten, anstehende Maßnahmen und deren wirtschaftliche Bedeutung besser einzuordnen.",
      "Beim Verkauf unterstützen aktuelle Grundrisse, nachvollziehbare Flächenangaben und eine realistische Einschätzung der Immobilie dabei, das Objekt vollständig und transparent vorzubereiten.",
    ],
  },
];

const jsonLd = subpageSchema(
  page,
  serviceSchemas(
    leistungen.map((l) => ({ name: l.name, description: l.description, path: l.href }))
  )
);
---

<BaseLayout page="dienstleistungen" jsonLd={jsonLd} headerVariant="overlay">
  <AnimatedPageHero
    title="Dienstleistungen"
    subtitle="Immobilienunterlagen als Grundlage für Planung, Bewertung und Vermarktung"
    intro="Vor-Ort-Aufmaß, digitale Grundrisse, Wohn- und Nutzflächenberechnungen sowie eine unabhängige An- und Verkaufsberatung."
    pattern={false}
  >
    <MeasureScan />
  </AnimatedPageHero>

  <Breadcrumbs page="dienstleistungen" force />

  {/* ---------------- The four services ---------------- */}
  <section class="bc-section mx-auto w-full max-w-[1400px] px-5 lg:px-8"
    aria-labelledby="leistungen-titel"
  >
    <div class="mb-10 max-w-2xl lg:mb-14">
      <h2
        id="leistungen-titel"
        class="reveal-on-scroll font-display mt-3 text-3xl text-ink sm:text-4xl lg:text-[40px]"
        data-reveal
      >
        Vier Grundlagen für sichere Entscheidungen
      </h2>
    </div>

    <ul class="grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        leistungen.map((item, i) => (
          <li
            class="reveal-on-scroll group relative overflow-hidden rounded-md border border-[color:var(--bc-border)] bg-surface"
            data-reveal
            style={`transition-delay:${i * 100}ms`}
          >
            <div class="relative h-[190px] overflow-hidden lg:h-[210px]">
              <Image
                src={item.img}
                widths={[420, 640]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                quality={90}
                alt={item.imgAlt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
            </div>
            <div class="p-5 lg:p-6">
              <h3 class="font-display text-lg text-ink lg:text-xl">
                <a href={item.href} class="after:absolute after:inset-0 after:content-['']">
                  {item.name}
                </a>
              </h3>
              <span
                class="mt-2 block h-[3px] w-8 rounded-full bg-[color:var(--bc-accent-deco)] transition-all duration-500 group-hover:w-14"
                aria-hidden="true"
              />
              <p class="mt-3 text-[14px] leading-relaxed text-muted">{item.description}</p>
              <span
                class="bc-btn bc-btn-ghost mt-4 text-sm group-hover:text-ink"
                aria-hidden="true"
              >
                Mehr erfahren
                <Icon name="arrow-dr" />
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------- Why documents matter ---------------- */}
  {/* No border: fades to the page colour over a fixed 96px at top and
      bottom, same treatment as the other banded sections on the site.
      SurveyContour is one of the three drawing patterns
      (gutachten, and others), a topographic-survey motif here — this page
      is about paperwork/Unterlagen, so "surveyed on site" fits better
      than the stepped-elevation variant used on ingenieurleistungen. */}
  <section
    class="relative overflow-hidden"
    style="background-image: linear-gradient(to bottom, var(--bc-page) 0, var(--bc-surface) 96px, var(--bc-surface) calc(100% - 96px), var(--bc-page) 100%)"
    aria-labelledby="grundlage-titel"
  >
    <SurveyContour />
    <div class="relative z-10 mx-auto w-full max-w-[1400px] px-5 bc-section lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-20">
        <div>
          <h2
            id="grundlage-titel"
            class="reveal-on-scroll font-display mt-3 text-3xl text-ink sm:text-4xl lg:text-[40px]"
            data-reveal
          >
            Wenn aktuelle Unterlagen fehlen oder Entscheidungen anstehen
          </h2>

          <div class="mt-8 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {
              unterlagen.map((eintrag, i) => (
                <div
                  class="reveal-on-scroll group flex items-start gap-3 rounded-md p-3 transition-colors hover:bg-[color:var(--bc-surface)]"
                  data-reveal
                  style={`transition-delay:${i * 60}ms`}
                >
                  <Icon name={eintrag.icon} class="mt-0.5 h-6 w-6 shrink-0 text-accent-deco" />
                  <span class="pt-0.5 text-[15px] font-medium text-ink">{eintrag.label}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="max-w-2xl">
          <p class="reveal-on-scroll text-base leading-relaxed text-muted" data-reveal>
            Bei vielen Bestandsimmobilien stimmen vorhandene Pläne und Flächenangaben nicht mehr
            mit dem tatsächlichen Gebäude überein. Umbauten wurden nicht nachgetragen, Grundrisse
            verändert oder Unterlagen sind über die Jahre verloren gegangen. Spätestens bei
            Verkauf, Vermietung, Finanzierung, Modernisierung oder Immobilienbewertung werden
            aktuelle Daten wieder wichtig.
          </p>
          <p
            class="reveal-on-scroll mt-5 text-base leading-relaxed text-muted"
            data-reveal
            style="transition-delay:80ms"
          >
            Mit einem digitalen Vor-Ort-Aufmaß erfassen wir den heutigen Gebäudebestand und
            erstellen daraus auf Wunsch aktuelle Grundrisse sowie Wohn- und
            Nutzflächenberechnungen. Wenn Sie eine Immobilie kaufen oder verkaufen möchten,
            unterstützen wir Sie zusätzlich mit einer unabhängigen technischen und
            wirtschaftlichen Einschätzung.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- Two concrete situations ---------------- */}
  <section class="bc-section mx-auto w-full max-w-[1400px] px-5 lg:px-8"
    aria-labelledby="situationen-titel"
  >
    <VerticalFeatureTabs
      heading="Wann diese Unterlagen den Unterschied machen"
      headingId="situationen-titel"
      idPrefix="situationen"
      tabs={situationen}
    />
  </section>

  {/* ---------------- Area served ---------------- */}
  <EinsatzgebietSection />

  {/* ---------------- Closing ---------------- */}
  <ClosingCta
    heading="Die Grundlage für sichere Entscheidungen"
    text="Ob Aufmaß, Grundriss, Flächenberechnung oder Beratung beim Kauf und Verkauf – schildern Sie uns kurz, was Sie benötigen. Wir prüfen Ihr Anliegen und melden uns persönlich bei Ihnen, um die nächsten Schritte zu besprechen."
    buttonHref={routes.kontakt}
  />
</BaseLayout>
