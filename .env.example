# ---------------------------------------------------------------------------
# BC IMMOWERT — environment variables
#
# Copy to .env for local development. .env is git-ignored and must never be
# committed or deployed as a readable file.
#
# NAMING RULE (enforced by vite.config.ts `envPrefix`):
#   PUBLIC_*  -> inlined into the JavaScript bundle, visible to every visitor.
#                Only ever put non-secret values here.
#   anything else -> server-side only, never reaches the browser.
#
# This file only covers what the Astro BUILD reads (values baked into the
# static site at `npm run build` time). The contact form's server-side
# secrets (RECAPTCHA_SECRET_KEY, RESEND_API_KEY, ...) live in a separate
# place — see server/.env.example — because they belong to server/app.js,
# a standalone Node app deployed on cPanel, not to this static build.
# ---------------------------------------------------------------------------

# --- Required now ---------------------------------------------------------

# Canonical origin, no trailing slash. Drives canonical URLs, Open Graph URLs,
# sitemap.xml, robots.txt and JSON-LD. Must be the HTTPS production domain.
PUBLIC_SITE_URL=https://bc-immowert.de

# reCAPTCHA v3 site key — public by design, safe in frontend code. From the
# same Google account as RECAPTCHA_SECRET_KEY in server/.env.example.
# https://www.google.com/recaptcha/admin/create (choose reCAPTCHA v3).
PUBLIC_RECAPTCHA_SITE_KEY=


# --- Optional: Google Analytics (GA4) ---------------------------------
# Consent-gated already (see ConsentBanner.astro / site.js / Datenschutz
# section 8) — setting this is the only step needed to switch it on. Until
# it's set, no marker renders and the consent banner stays inert.

# GA4 measurement ID. Public by design.
# PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (public by design).
# Prefer DNS or file verification instead where possible.
# PUBLIC_GSC_VERIFICATION=
