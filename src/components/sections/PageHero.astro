---
/**
 * Page header for subpages: a photograph with the page title over it.
 *
 * Deliberately shorter than the homepage hero (roughly half the viewport).
 * The source photographs are 1780x745, so a banner-height header uses close to
 * their native resolution instead of upscaling them the way a full-screen hero
 * does — see docs/MASTER-TEMPLATE.md, "Source resolution".
 *
 * Carries the page's single <h1>. The title and subtitle animate in with CSS,
 * so the heading — the Largest Contentful Paint element — is painted without
 * waiting for any script.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  /** A single line, or a few short phrases rendered with a divider between them. */
  subtitle?: string | string[];
  image: ImageMetadata;
  /** Describe the photograph, or leave empty if it is purely atmospheric. */
  imageAlt?: string;
}
const { title, subtitle, image, imageAlt = "" } = Astro.props;
const subtitleParts = Array.isArray(subtitle) ? subtitle : subtitle ? [subtitle] : [];
---

<section class="relative w-full overflow-hidden bg-black text-white" aria-labelledby="seiten-titel">
  <div class="absolute inset-0">
    <Picture
      src={image}
      formats={["avif", "webp"]}
      widths={[960, 1440, 1780]}
      quality={92}
      sizes="100vw"
      alt={imageAlt}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(20,18,14,0.80) 0%, rgba(20,18,14,0.45) 45%, rgba(20,18,14,0.72) 100%)"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-[1400px] flex-col justify-end px-5 pb-14 pt-[168px] lg:px-8 lg:pb-20 lg:pt-[220px]"
  >
    <h1
      id="seiten-titel"
      class="reveal bc-hero-title font-display text-white"
      style="animation-delay:.15s"
    >
      {title}
    </h1>
    {
      subtitleParts.length > 0 && (
        <p
          class="reveal pagehero-subtitle mt-4 flex max-w-2xl flex-wrap items-center gap-x-3 gap-y-1 text-lg text-white/85 lg:max-w-3xl lg:flex-nowrap lg:gap-x-0 lg:text-xl"
          style="animation-delay:.3s"
        >
          {subtitleParts.map((part, i) => (
            <span class="flex items-center whitespace-nowrap lg:whitespace-nowrap">
              {i > 0 && (
                <span class="hidden lg:inline-block" aria-hidden="true">
                  <span class="bc-divider" />
                </span>
              )}
              {part}
            </span>
          ))}
        </p>
      )
    }
  </div>
</section>

<style>
  /* Several short phrases (bauschadenbewertung, restnutzungsdauergutachten)
     must read as one line on desktop, never breaking mid-phrase — see the
     same whitespace-nowrap treatment on Hero's H1. The shared .bc-divider
     (global.css) carries a generous 0.6em margin meant for looser contexts
     (breadcrumbs, trust row); scoped tighter here so three phrases plus two
     dividers fit max-w-3xl without crowding the type. Astro scopes this
     rule to elements rendered by THIS component only — it does not touch
     .bc-divider anywhere else on the site. */
  .pagehero-subtitle :global(.bc-divider) {
    margin: 0 0.35em;
  }
</style>