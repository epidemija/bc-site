---
/**
 * Decorative "survey contour" pattern for section transitions: six thin,
 * layered irregular lines plotted from coarse, unevenly spaced points
 * (not a smooth curve), two benchmark-point marks, a measured baseline and
 * two contour heights — reads as a
 * topographic/site survey rather than an abstract wave. One of the three
 * drawing patterns used on the band sections (with StepElevation and
 * FloorPlanLines) — same footprint, same edge fade, so a section can swap
 * one for another without any other change.
 *
 * Positioned as an absolute background layer by the caller's own `relative`
 * wrapper; the band's content carries z-10 and is never drawn over. Shared
 * styling (mask, dimension figures) lives in global.css § 8e — the figures
 * are HTML because the SVG is stretched to the band width and would squash
 * text out of shape.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div
  class={`bc-pattern pointer-events-none absolute inset-x-0 top-0 h-40 w-full lg:h-48 ${className}`}
  aria-hidden="true"
>
  <svg class="bc-pattern__svg" viewBox="0 0 1200 210" preserveAspectRatio="none" focusable="false">
  <path
    d="M -58.0 50.1 L 0.0 53.2 L 58.0 53.6 L 116.0 52.3 L 174.0 50.7 L 232.0 50.4 L 290.0 51.9 L 348.0 54.7 L 406.0 57.4 L 464.0 58.3 L 522.0 56.2 L 580.0 51.2 L 638.0 44.6 L 696.0 38.4 L 754.0 34.3 L 812.0 33.4 L 870.0 35.1 L 928.0 38.2 L 986.0 40.9 L 1044.0 41.9 L 1102.0 41.2 L 1160.0 39.6 L 1218.0 38.8"
    stroke="var(--bc-border-strong)"
    stroke-opacity="0.55"
    stroke-width="1"
    fill="none"
  />
  <path
    d="M -64.0 80.0 L 0.0 78.7 L 64.0 79.1 L 128.0 82.7 L 192.0 88.6 L 256.0 94.4 L 320.0 97.1 L 384.0 94.9 L 448.0 88.1 L 512.0 79.4 L 576.0 72.0 L 640.0 68.3 L 704.0 68.5 L 768.0 70.8 L 832.0 72.5 L 896.0 71.6 L 960.0 68.2 L 1024.0 64.4 L 1088.0 62.9 L 1152.0 65.7 L 1216.0 72.9"
    stroke="var(--bc-border-strong)"
    stroke-opacity="0.45"
    stroke-width="1"
    fill="none"
  />
  <path
    d="M -70.0 102.6 L 0.0 110.3 L 70.0 120.9 L 140.0 129.4 L 210.0 131.7 L 280.0 126.9 L 350.0 117.7 L 420.0 109.1 L 490.0 104.8 L 560.0 105.1 L 630.0 106.8 L 700.0 106.0 L 770.0 100.8 L 840.0 92.8 L 910.0 86.4 L 980.0 85.8 L 1050.0 92.3 L 1120.0 103.4 L 1190.0 113.9 L 1260.0 119.7"
    stroke="var(--bc-border-strong)"
    stroke-opacity="0.38"
    stroke-width="1"
    fill="none"
  />
  <path
    d="M -52.0 145.2 L 0.0 150.8 L 52.0 153.5 L 104.0 152.9 L 156.0 149.8 L 208.0 145.5 L 260.0 141.8 L 312.0 139.7 L 364.0 139.6 L 416.0 140.8 L 468.0 142.0 L 520.0 141.8 L 572.0 139.2 L 624.0 134.2 L 676.0 127.8 L 728.0 121.6 L 780.0 117.3 L 832.0 116.1 L 884.0 118.4 L 936.0 123.2 L 988.0 129.2 L 1040.0 134.6 L 1092.0 138.1 L 1144.0 139.3 L 1196.0 138.6 L 1248.0 137.5"
    stroke="var(--bc-border-strong)"
    stroke-opacity="0.3"
    stroke-width="1"
    fill="none"
  />
  <path
    d="M -60.0 170.1 L 0.0 168.8 L 60.0 166.5 L 120.0 164.9 L 180.0 165.2 L 240.0 167.2 L 300.0 169.5 L 360.0 170.3 L 420.0 168.2 L 480.0 163.1 L 540.0 156.4 L 600.0 150.1 L 660.0 146.4 L 720.0 146.1 L 780.0 148.7 L 840.0 152.7 L 900.0 156.0 L 960.0 157.4 L 1020.0 156.9 L 1080.0 155.7 L 1140.0 155.5 L 1200.0 157.7"
    stroke="var(--bc-border-strong)"
    stroke-opacity="0.22"
    stroke-width="1"
    fill="none"
  />
  <path
    d="M -66.0 182.0 L 0.0 182.6 L 66.0 185.1 L 132.0 188.4 L 198.0 190.5 L 264.0 189.9 L 330.0 186.2 L 396.0 180.7 L 462.0 175.6 L 528.0 172.6 L 594.0 172.5 L 660.0 174.2 L 726.0 176.0 L 792.0 176.3 L 858.0 175.0 L 924.0 173.1 L 990.0 172.5 L 1056.0 174.4 L 1122.0 179.0 L 1188.0 184.6 L 1254.0 189.0"
    stroke="var(--bc-border-strong)"
    stroke-opacity="0.14"
    stroke-width="1"
    fill="none"
  />

  {/*
    Two small benchmark-point marks (circle + centre cross, the usual
    survey-station symbol) at a couple of the contour bends — the single
    most literal "surveyed" cue in the pattern; everything else stays
    understated on purpose.
  */}
  <g stroke="var(--bc-border-strong)" stroke-width="1" fill="none" stroke-opacity="0.4">
    <circle cx="320.0" cy="97.1" r="3.5" />
    <path d="M 320.0 93.6 V 100.6 M 316.5 97.1 H 323.5" />
  </g>
  <g stroke="var(--bc-border-strong)" stroke-width="1" fill="none" stroke-opacity="0.32">
    <circle cx="980.0" cy="85.8" r="3.5"></circle>
    <path d="M 980.0 82.3 V 89.3 M 976.5 85.8 H 983.5"></path>
  </g>

  {/* A measured baseline between the two benchmarks and a levelled contour
      height on a leader line. Both sit in the strip above the contours, which
      is the one part of a band that is always clear of the heading; their
      figures are the HTML spans below. */}
  <g stroke="var(--bc-border-strong)" stroke-width="1" fill="none" stroke-opacity="0.3">
    <path d="M 250 12 V 34 M 720 12 V 34"></path>
    <path d="M 250 22 H 430 M 540 22 H 720"></path>
    <path d="M 258 18 L 250 22 L 258 26 M 712 18 L 720 22 L 712 26"></path>
  </g>
  <g stroke="var(--bc-border-strong)" stroke-width="1" fill="none" stroke-opacity="0.28">
    <path d="M 900 26 V 40 L 940 52"></path>
    <circle cx="940" cy="52" r="2.5"></circle>
  </g>
  </svg>

  {/* x/1200 and y/210 as percentages — the same proportions the stretched SVG
      uses, so the figures stay on their line at every width. */}
  <span class="bc-pattern__dim" style="left: 40.4%; top: 10.5%">46,20 m</span>
  <span class="bc-pattern__dim" style="left: 75.0%; top: 10.5%">112,50</span>
</div>

