---
/**
 * Einzelmaßnahmen — service page, second level.
 *
 * Sibling of /ingenieurleistungen/energetische-modernisierung/ and built to the
 * same skeleton: photographic header, one <h1>, the four related lists as one
 * compact FactGrid (§5e), the engineering Ablauf, a closing enquiry.
 *
 * NAMING: the URL segment is "einzelmodernisierung" (kept as it is, in case it
 * is already indexed), but every visible label — menu, card, breadcrumb, <h1>,
 * <title> — now says "Einzelmaßnahmen", which is what the homepage slider
 * already called it.
 */
import { Picture } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { faqFor } from "../../../config/faq";
import FaqSection from "../../../components/sections/FaqSection.astro";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import PageHero from "../../../components/sections/PageHero.astro";
import FactGrid, { type FactCard } from "../../../components/sections/FactGrid.astro";
import ProcessSteps from "../../../components/sections/ProcessSteps.astro";
import SurveyContour from "../../../components/ui/SurveyContour.astro";
import { PAGES } from "../../../config/pages";
import { subpageSchema, serviceSchemas, howToSchema, faqSchema } from "../../../seo/schema";
import { routes } from "../../../config/site";
import { ABLAUF_INGENIEUR } from "../../../config/process";
import heroImage from "../../../assets/images/hero-bc-immowert-einzelmodernisierung.jpg";
import ClosingCta from "../../../components/sections/ClosingCta.astro";

const page = PAGES.einzelmodernisierung;

/* ------------------------------------------------------------- content */

const cards: FactCard[] = [
  {
    icon: "check",
    title: "Wann sind Einzelmaßnahmen sinnvoll?",
    items: [
      "bei geplanten Renovierungen oder Modernisierungen einzelner Bereiche",
      "bei funktionalen Anpassungen von Grundrissen oder Nutzung",
      "bei Schäden oder Abnutzung einzelner Bauteile",
      "zur Wertsteigerung vor Verkauf oder Vermietung",
      "bei individuellen Anpassungen an neue Anforderungen",
    ],
  },
  {
    icon: "trend",
    title: "Vorteile von Einzelmaßnahmen",
    items: [
      "gezielte Optimierung einzelner Bereiche",
      "überschaubarer Kostenrahmen",
      "flexible Umsetzung nach Bedarf",
      "Verbesserung von Funktionalität und Wohnkomfort",
      "nachhaltige Aufwertung der Immobilie",
    ],
  },
  {
    icon: "target",
    title: "Ziel von Einzelmaßnahmen",
    items: [
      "wirtschaftlich sinnvolle Verbesserung bestehender Strukturen",
      "Anpassung der Immobilie an aktuelle Anforderungen",
      "Erhöhung von Qualität, Nutzung und Komfort",
      "Schaffung einer soliden Grundlage für weitere Maßnahmen",
    ],
  },
  {
    icon: "award",
    title: "Warum wir?",
    items: [
      "Erfahrung aus zahlreichen begleiteten Modernisierungsmaßnahmen",
      "Zielgerichtete und praxisnahe Umsetzung auch im kleineren Rahmen",
      "Regionales Netzwerk an erfahrenen Handwerkern",
      "Effiziente Koordination und zuverlässige Abwicklung",
      "Individuelle Lösungen abgestimmt auf das jeweilige Vorhaben",
    ],
  },
];

const steps = ABLAUF_INGENIEUR;

/* -------------------------------------------------------------- schema */

const jsonLd = subpageSchema(page, [
  faqSchema(faqFor("einzelmassnahmen")?.entries ?? []),
  ...serviceSchemas([
    {
      name: "Einzelmaßnahmen",
      description:
        "Planung und koordinierte Umsetzung einzelner baulicher Maßnahmen — Umbauten, " +
        "Renovierungen und Teilmodernisierungen an Bestandsimmobilien, begleitet von einem " +
        "Bauingenieur.",
      path: page.path,
    },
  ]),
  howToSchema({
    page,
    name: "Ablauf einer Einzelmaßnahme",
    steps: steps.map(({ title, text }) => ({ title, text })),
  }),
]);
---

<BaseLayout page="einzelmodernisierung" jsonLd={jsonLd} headerVariant="overlay">
  <PageHero
    title="Einzelmaßnahmen"
    subtitle="Gezielte Planung und Umsetzung"
    image={heroImage}
    imageAlt="Bestandsimmobilie während einer einzelnen Umbau- und Renovierungsmaßnahme"
  />

  <Breadcrumbs page="einzelmodernisierung" />

  {/* ---------------- Introduction ----------------
      Text-and-photo layout, matching /gutachten/immobilienbewertung/: all
      copy in one column, a photo beside it. TEMPORARY: reusing the page's
      own hero photo here until a dedicated shot exists for this spot. */}
  <section class="bc-section mx-auto w-full max-w-[1400px] px-5 lg:px-8"
    aria-labelledby="grundlage-titel"
  >
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div>
        <h2
          id="grundlage-titel"
          class="reveal-on-scroll font-display text-3xl text-ink sm:text-4xl lg:text-[40px]"
          data-reveal
        >
          Nicht jedes Vorhaben braucht eine Komplettsanierung
        </h2>
        <p class="reveal-on-scroll mt-5 text-base leading-relaxed text-muted" data-reveal>
          Einzelmaßnahmen wie Umbauten, Renovierungen oder Teilmodernisierungen erfordern eine
          fachlich fundierte Planung und abgestimmte Umsetzung. Ziel ist es, bestehende Bereiche
          gezielt zu optimieren und funktionale sowie wirtschaftlich sinnvolle Lösungen zu
          realisieren.
        </p>
        <p
          class="reveal-on-scroll mt-5 text-base leading-relaxed text-muted"
          data-reveal
          style="transition-delay:100ms"
        >
          Auch eine einzelne Maßnahme greift in ein bestehendes Gebäude ein. Deshalb prüfen wir
          vorab, was sie technisch voraussetzt und was sie für die übrigen Bauteile bedeutet —
          damit die Verbesserung an einer Stelle nicht an anderer Stelle Folgekosten erzeugt.
        </p>
      </div>

      <div
        class="reveal-on-scroll aspect-[4/3] w-full overflow-hidden rounded-md border border-[color:var(--bc-border)]"
        data-reveal
        style="transition-delay:150ms"
      >
        <Picture
          src={heroImage}
          formats={["avif", "webp"]}
          widths={[480, 720, 960]}
          quality={92}
          sizes="(min-width: 1024px) 640px, 100vw"
          alt="Bestandsimmobilie während einer einzelnen Umbau- und Renovierungsmaßnahme"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  {/* ---------------- The four lists, compacted ----------------
      No visible eyebrow/heading — four self-explanatory cards need no
      section title above them; kept as a screen-reader-only heading so the
      section still has a real accessible name. No border: the wash fades to
      the page colour over a fixed 96px at top and bottom, same treatment as
      ProcessSteps' band below it — a soft transition instead of a
      hard-edged panel. */}
  <section
    class="relative overflow-hidden"
    aria-labelledby="ueberblick-titel"
    style="background-image: linear-gradient(to bottom, var(--bc-page) 0, color-mix(in srgb, var(--bc-surface) 55%, var(--bc-page)) 96px, color-mix(in srgb, var(--bc-surface) 55%, var(--bc-page)) calc(100% - 96px), var(--bc-page) 100%)"
  >
    <SurveyContour />
    <div class="relative z-10 mx-auto w-full max-w-[1400px] px-5 bc-section lg:px-8">
      <h2 id="ueberblick-titel" class="sr-only">
        Anlass, Nutzen und Ziel auf einen Blick
      </h2>

      <FactGrid cards={cards} />
    </div>
  </section>

  {/* ---------------- Process ---------------- */}
  <ProcessSteps steps={steps} eyebrow="" />

  {/* ---------------- Closing ---------------- */}

  <FaqSection category="einzelmassnahmen" eyebrow="" />

  <ClosingCta heading="Eine Maßnahme im Kopf?" text="Ob Wanddurchbruch, neues Bad, Fenstertausch oder die Umnutzung eines Raums — schildern Sie uns kurz, was Sie vorhaben. Wir sagen Ihnen, was technisch dafür nötig ist und in welcher Reihenfolge es sinnvoll ist." buttonHref={routes.kontakt} />
</BaseLayout>
