---
/**
 * Animated wall section: what an energetic modernisation actually changes.
 *
 * A cross-section through an existing wall. Heat streams out through it, an
 * insulation layer is applied, and the heat loss collapses. That is the whole
 * argument of the service, shown rather than asserted.
 *
 * Inline SVG plus CSS keyframes — no library, no JavaScript, decorative and
 * hidden from assistive technology, and it stops under `prefers-reduced-motion`
 * with the finished, insulated wall on screen.
 *
 * No U-values or savings figures. A number in a decorative graphic on an
 * engineer's website reads as a promise about a specific building, and no
 * building has been assessed here — the same rule as ValuationScan.astro.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

/** Vertical positions of the heat streams. */
const streams = [70, 108, 146, 184, 222];
---

<div class={`th ${className}`} aria-hidden="true">
  <svg viewBox="0 0 520 300" class="th-svg w-full" role="presentation">
    <defs>
      <pattern id="th-masonry" width="26" height="16" patternUnits="userSpaceOnUse">
        <rect width="26" height="16" fill="none" />
        <path d="M0 16h26M13 0v16M0 8h26" stroke="currentColor" stroke-width="0.6" opacity="0.35" />
      </pattern>
      <pattern id="th-insulation" width="10" height="10" patternUnits="userSpaceOnUse">
        <path d="M0 10L10 0M-2 2L2 -2M8 12L12 8" stroke="var(--bc-accent-deco)" stroke-width="1.1" opacity="0.75" />
      </pattern>
      <clipPath id="th-outside">
        <rect x="0" y="40" width="196" height="220" />
      </clipPath>
    </defs>

    {/* ---- Sides ---- */}
    <text x="18" y="34" class="th-side">Außen</text>
    <text x="502" y="34" class="th-side" text-anchor="end">Innen</text>
    <line x1="18" y1="44" x2="196" y2="44" class="th-rule"></line>
    <line x1="330" y1="44" x2="502" y2="44" class="th-rule"></line>

    {/* ---- The existing wall ---- */}
    <g class="th-wall">
      <rect x="238" y="52" width="92" height="208" fill="url(#th-masonry)" stroke="currentColor" stroke-width="1.5" />
      <text x="284" y="294" class="th-layer" text-anchor="middle">Bestandswand</text>
    </g>

    {/* ---- The insulation, applied to the outside face ---- */}
    <g class="th-damm">
      <rect x="196" y="52" width="42" height="208" fill="url(#th-insulation)" stroke="var(--bc-accent-deco)" stroke-width="1.5" />
      <text x="217" y="276" class="th-layer th-layer--accent" text-anchor="middle">Dämmung</text>
    </g>

    {/* ---- Heat leaving the building ----
         Two sets on the same paths: the long streams that escape before the
         insulation exists, and the short ones that stop at it afterwards. */}
    {
      streams.map((y, i) => (
        <g style={`--i:${i}`}>
          <path
            class="th-flow th-flow--long"
            d={`M330 ${y} C 300 ${y - 10}, 268 ${y + 10}, 238 ${y} S 176 ${y - 10}, 128 ${y}`}
            fill="none"
            stroke-width="2"
          />
          <path
            class="th-flow th-flow--short"
            d={`M330 ${y} C 312 ${y - 8}, 296 ${y + 8}, 280 ${y}`}
            fill="none"
            stroke-width="2"
          />
        </g>
      ))
    }

    {/* ---- Heat-loss meter ---- */}
    <g class="th-meter">
      <text x="18" y="264" class="th-meter-label">Wärmeverlust</text>
      <rect x="18" y="272" width="150" height="6" rx="3" class="th-meter-track" />
      <rect x="18" y="272" height="6" rx="3" class="th-meter-fill" />
    </g>
  </svg>
</div>

<style>
  .th {
    color: currentColor;
  }
  .th-svg {
    overflow: visible;
  }

  .th-side,
  .th-layer,
  .th-meter-label {
    fill: currentColor;
    font-family: "Inter", system-ui, sans-serif;
  }
  .th-side {
    font-size: 12px;
    
    text-transform: uppercase;
    opacity: 0.6;
  }
  .th-layer {
    font-size: 11px;
    opacity: 0.7;
  }
  .th-layer--accent {
    fill: var(--bc-accent-deco);
    opacity: 1;
  }
  .th-meter-label {
    font-size: 10px;
    
    text-transform: uppercase;
    opacity: 0.55;
  }
  .th-rule {
    stroke: currentColor;
    opacity: 0.25;
  }

  /* The wall draws itself once; everything after it runs on a loop. */
  .th-wall rect {
    stroke-dasharray: 620;
    stroke-dashoffset: 620;
    animation: th-draw 1.4s ease-out forwards;
  }
  .th-wall text {
    opacity: 0;
    animation: th-fade 0.6s ease-out 1.1s forwards;
  }

  /*
   * One 9-second cycle drives the whole story, so the layer, the two sets of
   * streams and the meter can never fall out of step: heat escapes, the
   * insulation goes on at 40 %, the loss drops.
   */
  .th-damm {
    opacity: 0;
    transform: translateX(30px);
    animation: th-apply 9s ease-in-out 1.6s infinite;
  }

  .th-flow {
    stroke: var(--bc-accent-deco);
    stroke-linecap: round;
    stroke-dasharray: 14 12;
  }
  .th-flow--long {
    opacity: 0;
    animation:
      th-drift 2.2s linear infinite,
      th-long 9s ease-in-out 1.6s infinite;
    animation-delay: calc(var(--i) * -0.4s), 1.6s;
  }
  .th-flow--short {
    opacity: 0;
    animation:
      th-drift 2.6s linear infinite,
      th-short 9s ease-in-out 1.6s infinite;
    animation-delay: calc(var(--i) * -0.4s), 1.6s;
  }

  .th-meter-track {
    fill: currentColor;
    opacity: 0.18;
  }
  .th-meter-fill {
    fill: var(--bc-accent-deco);
    width: 150px;
    animation: th-loss 9s ease-in-out 1.6s infinite;
  }

  @keyframes th-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes th-fade {
    to {
      opacity: 1;
    }
  }
  /* Streams travel outwards; the dash offset does the moving. */
  @keyframes th-drift {
    to {
      stroke-dashoffset: -52;
    }
  }
  @keyframes th-apply {
    0%,
    32% {
      opacity: 0;
      transform: translateX(30px);
    }
    46%,
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes th-long {
    0%,
    32% {
      opacity: 0.9;
    }
    44%,
    100% {
      opacity: 0;
    }
  }
  @keyframes th-short {
    0%,
    38% {
      opacity: 0;
    }
    50%,
    100% {
      opacity: 0.9;
    }
  }
  @keyframes th-loss {
    0%,
    32% {
      width: 150px;
    }
    50%,
    100% {
      width: 34px;
    }
  }

  /* Decoration only: at rest the insulated wall is the informative state. */
  @media (prefers-reduced-motion: reduce) {
    .th-wall rect,
    .th-wall text,
    .th-damm,
    .th-flow--short,
    .th-meter-fill {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
      transform: none;
    }
    .th-flow--short {
      opacity: 0.9;
    }
    .th-flow--long {
      display: none;
    }
    .th-meter-fill {
      width: 34px;
    }
  }
</style>
