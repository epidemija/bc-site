---
/**
 * Homepage hero. Carries the page's single <h1> and the LCP image.
 *
 * Every entrance animation here is CSS, not JavaScript: the headline is the
 * Largest Contentful Paint element, and animating it in JS would keep it at
 * opacity 0 until the script ran — which measured 3.5 s on a throttled phone.
 *
 * The block reads top to bottom as one argument: who we are (eyebrow), what
 * we are (h1), which fields (the four service families), what that means for
 * the visitor (the sentence), and the two ways forward (the buttons). The
 * trust row sits on the bottom edge, the regional badge on the right.
 */
import { Picture, Image } from "astro:assets";
import heroImage from "../../assets/images/hero-bc-immowert-startseite.jpg";
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import { routes } from "../../config/site";
import { CERTIFICATES } from "../../config/certificates";

/**
 * The four service families. The vertical hairline between them is a
 * decorative border on the <li> itself (same technique as the trust row
 * below), never part of a term: a crawler reads four unbroken keywords, and
 * a screen reader reads a list instead of announcing anything between them.
 * Same reason they are <li>, not one run of text.
 */
const leistungsfelder = [
  "Immobilienbewertung",
  "Bauschadensbewertung",
  "Ingenieurleistungen",
  "Immobiliendienstleistungen",
];

/** Trust row on the bottom edge — four claims, one line of proof each. */
const merkmale: { icon: "shield" | "building" | "user" | "pin"; label: string }[] = [
  { icon: "shield", label: "Unabhängig & objektiv" },
  { icon: "building", label: "Fachlich fundiert und praxisnah" },
  { icon: "user", label: "Persönliche Beratung" },
  { icon: "pin", label: "Regional verwurzelt und flexibel" },
];

/** The badge repeats the region as a scannable stack, not as new information. */
const regionen = ["Speyer", "Vorderpfalz", "Rhein-Neckar"];
---

<section
  class="relative flex min-h-screen w-full flex-col overflow-hidden bg-black text-white"
  aria-labelledby="hero-titel"
>
  <div class="absolute inset-0">
    <Picture
      src={heroImage}
      formats={["avif", "webp"]}
      widths={[960, 1440, 1780]}
      quality={92}
      sizes="100vw"
      alt=""
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>

  {/* Two overlays: a vertical wash for the whole frame, and a soft column on
      the left so the text keeps its contrast over the bright part of the
      photograph without dimming the cathedral. */}
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(20,18,14,0.78) 0%, rgba(20,18,14,0.35) 40%, rgba(20,18,14,0.55) 75%, rgba(27,25,21,0.88) 100%)"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to right, rgba(20,18,14,0.62) 0%, rgba(20,18,14,0.30) 45%, rgba(20,18,14,0) 72%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 flex min-h-screen flex-col">
    {/* The header is fixed and rendered by BaseLayout; this spacer reserves
        the room it occupies over the photograph. */}
    <div class="h-[104px] shrink-0" aria-hidden="true"></div>

    <div class="flex flex-1 items-center">
      <div class="mx-auto w-full max-w-[1400px] px-5 py-10 lg:px-10 lg:py-14">
        <div class="flex items-stretch justify-between gap-10">
          <div class="max-w-[720px]">
            <h1
              id="hero-titel"
              class="reveal font-display text-[34px] leading-[1.06] text-white sm:text-5xl lg:text-[64px] lg:leading-[1.03] xl:text-[72px]"
              style="animation-delay:.55s"
            >
              Ingenieur- &amp; <span class="whitespace-nowrap">Sachverständigenbüro</span> für Immobilien <span class="text-accent-deco whitespace-nowrap"
                >in Speyer</span
              >
            </h1>

            <ul
              class="reveal mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-semibold uppercase tracking-[0.04em] text-white/65 lg:flex-nowrap lg:gap-x-0 lg:whitespace-nowrap"
              style="animation-delay:.65s"
            >
              {
                leistungsfelder.map((feld, i) => (
                  <li class={`flex items-center ${i > 0 ? "lg:border-l lg:border-white/20 lg:pl-3" : ""} ${i < leistungsfelder.length - 1 ? "lg:pr-3" : ""}`}>
                    {feld}
                  </li>
                ))
              }
            </ul>

            <p
              class="reveal mt-7 max-w-xl text-base leading-relaxed text-white/85 lg:text-lg"
              style="animation-delay:.75s"
            >
              Fundierte Beratung und technische Kompetenz rund um Ihre Immobilie – in Speyer, der
              Vorderpfalz und der Metropolregion Rhein-Neckar.
            </p>

            <div
              class="reveal mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4"
              style="animation-delay:.85s"
            >
              <Button href="#leistungen">Unsere Leistungen</Button>
              <Button href={routes.kontakt} variant="secondary" onDark>Unverbindlich anfragen</Button>
            </div>
          </div>

          {/* Right column: regional badge on top (hidden below lg: on a phone
              it would sit on top of the headline, and every word in it is
              already in the sentence above, so nothing is lost), DEKRA seals
              pinned to the bottom so they land level with the buttons on the
              left — the row above stretches this column to the left
              column's full height. */}
          <div class="hidden shrink-0 flex-col items-end justify-between lg:flex">
            <div
              class="reveal"
              style="animation-delay:.95s"
              aria-hidden="true"
            >
              <div
                class="flex h-[184px] w-[184px] flex-col items-center justify-center rounded-full bg-white/10 px-6 text-center backdrop-blur-[3px]"
              >
                <Icon name="pin" class="h-6 w-6 text-accent-deco" />
                <p class="mt-3 text-[15px] font-semibold leading-snug text-white">
                  Regional<br />für Sie da
                </p>
                <div class="mt-3 h-px w-8 bg-white/25"></div>
                <p class="mt-3 text-[13px] leading-relaxed text-white/75">
                  {regionen.map((r) => <span class="block">{r}</span>)}
                </p>
              </div>
            </div>

            {/* Both DEKRA seals as one link to the Zertifikate section on
                Über uns — no separate "view/verify" links here, that detail
                lives on the full section itself. */}
            <a
              href={`${routes.about}#zertifikate-titel`}
              class="reveal flex items-center gap-4 opacity-90 transition-opacity hover:opacity-100"
              style="animation-delay:1.05s"
              aria-label="Unsere DEKRA-Zertifizierungen ansehen"
            >
              {
                CERTIFICATES.map((cert) => (
                  <Image src={cert.img} alt={cert.alt} class="h-20 w-auto lg:h-40" loading="lazy" />
                ))
              }
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Trust row. Vertical hairlines only from lg, where the four sit in one
        line; on a phone they are a 2×2 grid and the rules would be noise. */}
    <div class="w-full px-5 pb-8 lg:px-10 lg:pb-10">
      <ul
        class="reveal mx-auto grid w-fit grid-cols-2 gap-x-6 gap-y-6 lg:grid-cols-4 lg:gap-x-0"
        style="animation-delay:1s"
      >
        {
          merkmale.map((m, i) => (
            <li
              class={`flex items-start gap-3 ${
                i > 0 ? "lg:border-l lg:border-white/15 lg:pl-8" : ""
              } ${i < merkmale.length - 1 ? "lg:pr-8" : ""}`}
            >
              <Icon name={m.icon} class="mt-0.5 h-6 w-6 shrink-0 text-accent-deco" />
              <span class="text-sm leading-snug text-white/85">{m.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
